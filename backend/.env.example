NODE_ENV=dev
PORT=3333
CORS_ORIGIN=http://localhost:5173

DATABASE_USER=campusfacil
DATABASE_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
DATABASE_NAME=campusfacil
DATABASE_URL=postgresql://campusfacil:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/campusfacil?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Development only: verification links are written to .local-mail/
EMAIL_DELIVERY=local

